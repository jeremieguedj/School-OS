{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://school-os.example/schemas/instance.schema.json",
  "title": "School-OS instance manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "instance_format_version",
    "instance_id",
    "system_version",
    "data_schema_version",
    "release_channel",
    "active_release",
    "configuration",
    "state",
    "last_completed_migration",
    "latest_release_seen"
  ],
  "properties": {
    "instance_format_version": {"type": "integer", "minimum": 1},
    "instance_id": {"type": "string", "minLength": 1},
    "system_version": {"type": "string", "minLength": 1},
    "data_schema_version": {"type": "integer", "minimum": 1},
    "release_channel": {"enum": ["development", "alpha", "beta", "stable"]},
    "active_release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "manifest_reference"],
      "properties": {
        "version": {"type": "string", "minLength": 1},
        "manifest_reference": {"type": "string", "minLength": 1}
      }
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["household_reference", "integrations_reference", "policies_reference", "daily_run_personal_values_reference"],
      "properties": {
        "household_reference": {"type": "string", "minLength": 1},
        "integrations_reference": {"type": "string", "minLength": 1},
        "policies_reference": {"type": "string", "minLength": 1},
        "daily_run_personal_values_reference": {"type": "string", "minLength": 1}
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file_map_reference", "operation_state_reference"],
      "properties": {
        "file_map_reference": {"type": "string", "minLength": 1},
        "operation_state_reference": {"type": "string", "minLength": 1}
      }
    },
    "last_completed_migration": {"type": ["string", "null"]},
    "latest_release_seen": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "source"],
      "properties": {
        "version": {"type": ["string", "null"]},
        "source": {"type": ["string", "null"]}
      }
    }
  }
}
