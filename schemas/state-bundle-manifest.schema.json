{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://school-os.example/schemas/state-bundle-manifest.schema.json",
  "title": "School-OS immutable state bundle manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["bundle_format", "bundle_kind", "configuration_fingerprint", "entries", "identity", "instance_id", "package_sha256", "predecessor", "schema_version", "settings_sha256"],
  "properties": {
    "bundle_format": {"const": "school-os-bundle-v1"},
    "bundle_kind": {"enum": ["state", "source", "output"]},
    "configuration_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["byte_length", "media_type", "path", "role", "schema_id", "sha256"],
        "properties": {
          "byte_length": {"type": "integer", "minimum": 0},
          "media_type": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1, "maxLength": 256},
          "role": {"type": "string", "minLength": 1},
          "schema_id": {"type": ["string", "null"]},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "identity": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "instance_id": {"type": "string", "minLength": 1},
    "package_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "predecessor": {"type": ["object", "null"]},
    "schema_version": {"const": 1},
    "settings_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
