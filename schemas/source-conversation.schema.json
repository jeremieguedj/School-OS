{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://school-os.example/schemas/source-conversation.schema.json",
  "title": "School-OS complete normalized source conversation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "adapter_id", "conversation_id", "scope", "pagination", "messages"],
  "properties": {
    "schema_version": {"const": 2},
    "adapter_id": {"type": "string", "minLength": 1},
    "conversation_id": {"type": "string", "minLength": 1},
    "scope": {"type": "object"},
    "pagination": {"type": "object", "additionalProperties": true, "required": ["completed"], "properties": {"completed": {"const": true}}},
    "messages": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["message_id", "received_at", "received_date", "body", "body_custody", "attachments", "resources"],
        "properties": {
          "message_id": {"type": "string", "minLength": 1},
          "received_at": {"type": "string", "minLength": 1},
          "received_date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
          "body": {"type": "string"},
          "body_custody": {
            "type": "object", "additionalProperties": false,
            "required": ["outcome", "complete", "content_id", "selected_part_id", "declared_charset", "content_transfer_encoding", "raw_part_sha256", "raw_part_byte_length", "raw_part_locator", "provider_unicode_sha256", "plaintext_sha256", "plaintext_byte_length"],
            "properties": {
              "outcome": {"const": "admitted"}, "complete": {"const": true},
              "content_id": {"type": "string", "minLength": 1}, "selected_part_id": {"type": "string", "minLength": 1},
              "declared_charset": {"type": "string", "minLength": 1}, "content_transfer_encoding": {"type": "string", "minLength": 1},
              "raw_part_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "raw_part_byte_length": {"type": "integer", "minimum": 0},
              "raw_part_locator": {"type": "object", "additionalProperties": false, "required": ["kind", "byte_start", "byte_end"], "properties": {"kind": {"const": "raw_part_bytes"}, "byte_start": {"const": 0}, "byte_end": {"type": "integer", "minimum": 0}}},
              "provider_unicode_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "plaintext_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "plaintext_byte_length": {"type": "integer", "minimum": 0}
            }
          },
          "attachments": {"type": "array", "items": {
            "type": "object", "additionalProperties": false,
            "required": ["outcome_id", "attachment_id", "content_id", "source_message_id", "origin", "outcome", "mime_type", "original_bytes_observed", "original_content_sha256", "extracted_text_sha256", "extracted_text", "locator", "read_evidence", "complete_units", "unit_count", "disposition_reason"],
            "properties": {
              "outcome_id": {"type": "string", "minLength": 1}, "attachment_id": {"type": "string", "minLength": 1}, "content_id": {"type": "string", "minLength": 1}, "source_message_id": {"type": "string", "minLength": 1},
              "origin": {"const": "mime_attachment"}, "outcome": {"enum": ["extracted", "duplicate", "unsupported", "inaccessible", "excluded_by_policy", "manual_review"]},
              "mime_type": {"type": ["string", "null"]}, "original_bytes_observed": {"type": "boolean"},
              "original_content_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}, "extracted_text_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
              "extracted_text": {"type": ["string", "null"]}, "locator": {"type": ["object", "null"]},
              "read_evidence": {"type": ["object", "null"], "additionalProperties": false, "required": ["complete", "identity", "mime_type", "declared_byte_size", "observed_byte_size", "mode", "locator", "version"], "properties": {"complete": {"const": true}, "identity": {"type": "string", "minLength": 1}, "mime_type": {"type": "string", "minLength": 1}, "declared_byte_size": {"type": "integer", "minimum": 0}, "observed_byte_size": {"type": ["integer", "null"], "minimum": 0}, "mode": {"enum": ["original_bytes", "provider_extracted_text"]}, "locator": {"type": "object"}, "version": {"type": ["string", "null"]}}},
              "complete_units": {"type": "array", "items": {"type": "string", "minLength": 1}}, "unit_count": {"type": ["integer", "null"], "minimum": 1},
              "disposition_reason": {"type": "string", "minLength": 1}
            }
          }},
          "resources": {"type": "array", "items": {
            "type": "object", "additionalProperties": false,
            "required": ["outcome_id", "resource_id", "content_id", "source_message_id", "origin", "outcome", "mime_type", "html_part_id", "html_part_sha256", "html_decoded_sha256", "occurrence", "attribute", "original_url", "final_url", "redirect_chain", "fetch_evidence", "original_bytes_observed", "original_content_sha256", "extracted_text_sha256", "extracted_text", "locator", "complete_units", "unit_count", "disposition_reason"],
            "properties": {
              "outcome_id": {"type": "string", "minLength": 1}, "resource_id": {"type": "string", "minLength": 1}, "content_id": {"type": "string", "minLength": 1}, "source_message_id": {"type": "string", "minLength": 1},
              "origin": {"enum": ["html_embedded", "html_linked"]}, "outcome": {"enum": ["extracted", "excluded_by_policy", "inaccessible", "manual_review"]},
              "mime_type": {"type": ["string", "null"]}, "html_part_id": {"type": "string", "minLength": 1}, "html_part_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "html_decoded_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "occurrence": {"type": "integer", "minimum": 0}, "attribute": {"type": "string", "minLength": 1}, "original_url": {"type": "string", "minLength": 1}, "final_url": {"type": ["string", "null"]},
              "redirect_chain": {"type": "array", "items": {"type": "string", "minLength": 1}},
              "fetch_evidence": {"type": ["object", "null"], "additionalProperties": false, "required": ["status_code", "complete", "eof", "bytes_read", "declared_content_length", "mime_type"], "properties": {"status_code": {"const": 200}, "complete": {"const": true}, "eof": {"const": true}, "bytes_read": {"type": "integer", "minimum": 1}, "declared_content_length": {"type": ["integer", "null"], "minimum": 1}, "mime_type": {"type": "string", "minLength": 1}}},
              "original_bytes_observed": {"type": "boolean"}, "original_content_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
              "extracted_text_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}, "extracted_text": {"type": ["string", "null"]}, "locator": {"type": ["object", "null"]},
              "complete_units": {"type": "array", "items": {"type": "string", "minLength": 1}}, "unit_count": {"type": ["integer", "null"], "minimum": 1},
              "disposition_reason": {"type": "string", "minLength": 1}
            }
          }}
        }
      }
    }
  }
}
