{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://school-os.example/schemas/operation-checkpoint.schema.json",
  "title": "School-OS immutable operation checkpoint",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "checkpoint_id", "operation_id", "attempt_id", "pinned_release", "scope", "configuration_fingerprint", "phase", "completed_phases", "completed_units", "remaining_work", "artifacts", "effects", "verification", "blocker", "predecessor", "sequence"],
  "properties": {
    "schema_version": {"type": "integer", "minimum": 1},
    "checkpoint_id": {"type": "string", "minLength": 1},
    "operation_id": {"type": "string", "minLength": 1},
    "attempt_id": {"type": "string", "minLength": 1},
    "pinned_release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "source_commit"],
      "properties": {
        "version": {"type": "string", "minLength": 1},
        "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "scope": {"type": "object"},
    "configuration_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "phase": {"type": "string", "minLength": 1},
    "completed_phases": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "completed_units": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "remaining_work": {"type": "object"},
    "artifacts": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["artifact_id", "reference", "sha256"],
            "properties": {
              "artifact_id": {"type": "string", "minLength": 1},
              "reference": {"type": "string", "minLength": 1},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "identity", "reference", "sha256"],
            "properties": {
              "kind": {"enum": ["source_bundle", "output_bundle"]},
              "identity": {"type": "string", "minLength": 1},
              "reference": {
                "type": "object",
                "additionalProperties": false,
                "required": ["object_id", "kind", "permitted_ancestor_id", "mime_type", "version"],
                "properties": {
                  "object_id": {"type": "string", "minLength": 1},
                  "kind": {"const": "file"},
                  "permitted_ancestor_id": {"type": "string", "minLength": 1},
                  "mime_type": {"type": "string", "minLength": 1},
                  "version": {"type": "string", "minLength": 1}
                }
              },
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            }
          }
        ]
      }
    },
    "effects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["effect_id", "kind", "outcome", "verification"],
        "properties": {
          "effect_id": {"type": "string", "minLength": 1},
          "kind": {"type": "string", "minLength": 1},
          "outcome": {"enum": ["pending", "confirmed", "definitely_not_applied", "unknown"]},
          "verification": {"type": "object"}
        }
      }
    },
    "verification": {"type": "object"},
    "blocker": {"type": ["object", "null"]},
    "predecessor": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["checkpoint_id", "sha256"],
      "properties": {
        "checkpoint_id": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "sequence": {"type": "integer", "minimum": 0}
  }
}
