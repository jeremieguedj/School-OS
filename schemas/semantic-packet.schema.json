{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://school-os.example/schemas/semantic-packet.schema.json",
  "title": "School-OS bounded semantic extraction packet",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_id", "conversation_id", "catalog_record_sha256", "segments", "source_outcomes"],
  "properties": {
    "schema_version": {"enum": [1, 2]},
    "record_id": {"type": "string", "minLength": 1},
    "conversation_id": {"type": "string", "minLength": 1},
    "catalog_record_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "mime_accounting": {"type": "array", "items": {"type": "object"}},
    "evidence_segments": {"type": "array", "items": {"type": "object"}},
    "source_outcomes": {"type": "array", "items": {
      "type": "object",
      "required": ["outcome_id", "content_id", "source_message_id", "source_kind", "origin", "outcome", "disposition_reason"],
      "properties": {
        "outcome_id": {"type": "string", "minLength": 1}, "content_id": {"type": "string", "minLength": 1}, "source_message_id": {"type": "string", "minLength": 1},
        "source_kind": {"enum": ["attachment", "resource"]}, "origin": {"enum": ["mime_attachment", "html_embedded", "html_linked"]},
        "outcome": {"enum": ["extracted", "duplicate", "excluded_by_policy"]}, "disposition_reason": {"type": "string", "minLength": 1}
      }
    }},
    "segments": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["segment_id", "content_id", "content_kind", "content_sha256", "source_message_id", "source_received_at", "received_date", "source_message_ordinal", "source_content_ordinal", "text"],
        "properties": {
          "segment_id": {"type": "string", "minLength": 1}, "content_id": {"type": "string", "minLength": 1},
          "content_kind": {"enum": ["body", "body_supplement", "attachment", "resource"]}, "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "source_message_id": {"type": "string", "minLength": 1}, "source_received_at": {"type": "string", "minLength": 1},
          "received_date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
          "source_message_ordinal": {"type": "integer", "minimum": 0}, "source_content_ordinal": {"type": "integer", "minimum": 0},
          "text": {"type": "string"}, "source_provenance": {"type": "object"}
        }
      }
    }
  }
}
