{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://school-os.example/schemas/task-adapter-snapshot.schema.json",
  "title": "Complete normalized task-adapter snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_version", "request_id", "provider_id", "adapter_id", "binding_id", "scope_sha256", "capture_id", "captured_at", "complete", "collections", "tasks", "unbound_candidates", "proposed_cursor", "evidence"],
  "properties": {
    "schema_version": {"const": 1},
    "contract_version": {"const": "agent-task-v1"},
    "request_id": {"type": "string", "minLength": 1},
    "provider_id": {"type": "string", "minLength": 1},
    "adapter_id": {"type": "string", "minLength": 1},
    "binding_id": {"type": "string", "minLength": 1},
    "scope_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "capture_id": {"type": "string", "minLength": 1},
    "captured_at": {"type": "string", "minLength": 1},
    "complete": {"const": true},
    "collections": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "tasks": {"type": "array", "items": {"type": "object"}},
    "unbound_candidates": {"type": "array", "items": {"type": "object"}},
    "proposed_cursor": {"type": ["string", "null"]},
    "evidence": {"type": "object"}
  }
}
