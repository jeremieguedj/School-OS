{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://school-os.example/schemas/task-provider-selector.schema.json",
  "title": "Selected agent-managed task projection",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "selected_provider", "status", "bindings", "switch"],
  "properties": {
    "schema_version": {"const": 2},
    "selected_provider": {"type": "string", "minLength": 1},
    "status": {"enum": ["unbound", "bound", "switching"]},
    "bindings": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/binding"}
    },
    "switch": {"type": ["object", "null"]}
  },
  "$defs": {
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter_configuration_path", "adapter_configuration_sha256", "adapter_contract_version", "adapter_id", "binding_id", "provider_id", "provider_state_path", "scope_sha256", "status"],
      "properties": {
        "adapter_configuration_path": {"type": "string", "minLength": 1},
        "adapter_configuration_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "adapter_contract_version": {"const": "agent-task-v1"},
        "adapter_id": {"type": "string", "minLength": 1},
        "binding_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,191}$"},
        "provider_id": {"type": "string", "minLength": 1},
        "provider_state_path": {"type": "string", "minLength": 1},
        "scope_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "status": {"enum": ["active", "dormant", "staging"]}
      }
    },
    "switch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["switch_id", "old_provider", "target_provider", "old_snapshot_sha256", "phase"],
      "properties": {
        "switch_id": {"type": "string", "minLength": 1},
        "old_provider": {"type": "string", "minLength": 1},
        "target_provider": {"type": "string", "minLength": 1},
        "old_snapshot_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "phase": {"const": "staging"}
      }
    }
  }
}
