{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://school-os.example/schemas/fact.schema.json",
  "title": "School-OS logical atomic fact",
  "type": "object",
  "additionalProperties": false,
  "required": ["fact_id", "record_id", "source_message_id", "source_byte_start", "source_byte_end", "received_date", "entity_scope", "category", "text", "flags"],
  "properties": {
    "fact_id": {"type": "string", "minLength": 1},
    "record_id": {"type": "string", "minLength": 1},
    "source_message_id": {"type": "string", "minLength": 1},
    "source_byte_start": {"type": "integer", "minimum": 0},
    "source_byte_end": {"type": "integer", "minimum": 1},
    "received_date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "entity_scope": {"type": "string"},
    "category": {"type": "string"},
    "text": {"type": "string", "minLength": 1},
    "flags": {"type": "object", "additionalProperties": false, "required": ["is_update", "is_durable", "is_guideline", "is_action"], "properties": {"is_update": {"type": "boolean"}, "is_durable": {"type": "boolean"}, "is_guideline": {"type": "boolean"}, "is_action": {"type": "boolean"}}},
    "attachment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attachment_id", "origin", "mime_type", "original_content_sha256", "extracted_text_sha256", "locator"],
      "properties": {
        "attachment_id": {"type": "string", "minLength": 1},
        "origin": {"enum": ["mime_attachment", "html_embedded", "html_linked"]},
        "mime_type": {"type": "string", "minLength": 1},
        "original_content_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "extracted_text_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "locator": {
          "oneOf": [
            {"type": "object", "additionalProperties": false, "required": ["kind", "byte_start", "byte_end"], "properties": {"kind": {"const": "extracted_text_span"}, "byte_start": {"type": "integer", "minimum": 0}, "byte_end": {"type": "integer", "minimum": 1}}},
            {"type": "object", "additionalProperties": false, "required": ["kind", "page", "region"], "properties": {"kind": {"const": "provider_page_region"}, "page": {"type": "integer", "minimum": 1}, "region": {"type": "string", "minLength": 1}}}
          ]
        }
      }
    }
  }
}
