{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://school-os.example/schemas/extraction-result.schema.json",
  "title": "School-OS bounded extraction result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "conversation_id", "candidates", "coverage", "attachment_outcomes", "review_cases"],
  "properties": {
    "schema_version": {"const": 1},
    "conversation_id": {"type": "string", "minLength": 1},
    "candidates": {"type": "array", "items": {
      "type": "object", "additionalProperties": false,
      "required": ["segment_id", "byte_start", "byte_end", "candidate_kind", "category", "entity_scope", "text", "flags", "source_quote_sha256"],
      "properties": {
        "segment_id": {"type": "string", "minLength": 1}, "byte_start": {"type": "integer", "minimum": 0}, "byte_end": {"type": "integer", "minimum": 1},
        "candidate_kind": {"type": "string", "minLength": 1}, "category": {"type": "string"}, "entity_scope": {"type": "string"}, "text": {"type": "string", "minLength": 1},
        "flags": {"type": "object"}, "task_relation": {"type": "object"}, "source_quote_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }},
    "coverage": {"type": "array", "minItems": 1, "items": {
      "type": "object", "additionalProperties": false, "required": ["segment_id", "byte_start", "byte_end", "outcome", "reason"],
      "properties": {"segment_id": {"type": "string", "minLength": 1}, "byte_start": {"type": "integer", "minimum": 0}, "byte_end": {"type": "integer", "minimum": 0}, "outcome": {"enum": ["fact", "no_fact", "review"]}, "reason": {"type": "string", "minLength": 1}}
    }},
    "attachment_outcomes": {"type": "array", "items": {
      "type": "object", "additionalProperties": false,
      "required": ["outcome_id", "content_id", "source_message_id", "source_kind", "source_id", "origin", "outcome", "mime_type", "original_content_sha256", "extracted_text_sha256", "locator", "complete_units", "unit_count", "disposition_reason", "provenance_sha256"],
      "properties": {
        "outcome_id": {"type": "string", "minLength": 1}, "content_id": {"type": "string", "minLength": 1}, "source_message_id": {"type": "string", "minLength": 1}, "source_kind": {"enum": ["attachment", "resource"]},
        "source_id": {"type": "string", "minLength": 1}, "origin": {"enum": ["mime_attachment", "html_embedded", "html_linked"]}, "outcome": {"enum": ["extracted", "duplicate", "excluded_by_policy"]},
        "mime_type": {"type": ["string", "null"]}, "original_content_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "extracted_text_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}, "locator": {"type": ["object", "null"]},
        "complete_units": {"type": "array", "items": {"type": "string", "minLength": 1}}, "unit_count": {"type": ["integer", "null"], "minimum": 1},
        "disposition_reason": {"type": "string", "minLength": 1}, "provenance_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }},
    "review_cases": {"type": "array", "items": {
      "type": "object", "additionalProperties": false, "required": ["segment_id", "byte_start", "byte_end", "reason"],
      "properties": {"segment_id": {"type": "string", "minLength": 1}, "byte_start": {"type": "integer", "minimum": 0}, "byte_end": {"type": "integer", "minimum": 0}, "reason": {"type": "string", "minLength": 1}}
    }}
  }
}
