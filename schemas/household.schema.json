{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://school-os.example/schemas/household.schema.json",
  "title": "School-OS household configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "timezone", "entities", "grouping"],
  "properties": {
    "schema_version": {"type": "integer", "minimum": 1},
    "timezone": {"type": "string", "minLength": 1},
    "entities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["entity_id", "display_name", "type", "sort_order"],
        "properties": {
          "entity_id": {"type": "string", "minLength": 1},
          "display_name": {"type": "string", "minLength": 1},
          "type": {"enum": ["child", "shared"]},
          "sort_order": {"type": "integer", "minimum": 0}
        }
      }
    },
    "grouping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonical_scope_field", "shared_group_id", "unscoped_update_group"],
      "properties": {
        "canonical_scope_field": {"enum": ["entities"]},
        "shared_group_id": {"type": "string", "minLength": 1},
        "unscoped_update_group": {"type": "string", "minLength": 1}
      }
    }
  }
}
